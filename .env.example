# Orden en que se prueban los proveedores de IA (si uno falla o tarda, se usa el siguiente).
# Mientras el Spark solo tenga llama3.1 8B, conviene poner Groq primero: groq,ollama
AI_PROVIDERS=ollama,groq

# Ollama en el Spark del instituto, publicado con Cloudflare Tunnel.
OLLAMA_BASE_URL=https://ollama.irisapp.es
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_MS=25000

# Groq (gratis, sin tarjeta): crea la key en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Clave opcional para los clientes. Déjalo en false: la web y la app son públicas.
IRIS_REQUIRE_API_KEY=false
IRIS_API_KEY=
